{
    "name": "se7enxweb/ibexa-legacy-bridge",
    "description": "Exponential Platform / Ibexa bridge to Exponential / eZ Publish Legacy",
    "license": "GPL-2.0-or-later",
    "type": "ezplatform-bundle",
    "authors": [
        {
            "name": "7x",
            "homepage": "https://se7enx.com"
        },
        {
            "name": "Netgen",
            "homepage": "https://netgen.io"
        },
        {
            "name": "eZ Systems",
            "email": "dev-team@ez.no"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "se7enxweb/exponential-legacy-installer": "^2.2.1",
        "se7enxweb/exponential": "dev-main",
        "ibexa/core": "^4.6",
        "netgen/ibexa-xmltext-fieldtype": "^3.0",
        "netgen/richtext-datatype-bundle": "^2.0",
        "se7enxweb/mediata-ezpage-fieldtype-bundle": "^1.0.1",
        "twig/twig": "^3.13"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^2.16.2",
        "ezsystems/ezplatform-code-style": "^0.1",
        "ezsystems/ezplatform-http-cache": "~0.9",
        "matthiasnoback/symfony-dependency-injection-test": "^2.3",
        "phpunit/phpunit": "^6.5",
        "mikey179/vfsstream": "~1.1.0"
    },
    "autoload": {
        "psr-4": {
            "eZ\\Bundle\\EzPublishLegacyBundle\\": "bundle/",
            "eZ\\Publish\\Core\\MVC\\Legacy\\": "mvc"
        }
    },
    "scripts": {
        "fix-cs": "php-cs-fixer fix -v --show-progress=estimating",
        "test": "vendor/bin/phpunit"
    },
    "extra": {
        "ezpublish-legacy-dir": "ezpublish_legacy",
        "branch-alias": {
            "dev-master": "4.0.x-dev"
        }
    }
}
